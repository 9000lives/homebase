# Homebase backend configuration.
#
# Copy to `.env` in the repository root and fill in real values.
# `.env` is gitignored and must never be committed.
#
# server/config/env.js validates all of this at startup and refuses to boot on
# a missing or weak required value, rather than failing later at request time.

# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string.
# Use a password generated by a password manager — long, random, and NOT derived
# from the database username. Restrict the Atlas Network Access allow-list to
# the deployment host's address; never leave 0.0.0.0/0 in place.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/homebase

# Signs session tokens. Must be at least 32 characters of real entropy —
# startup fails otherwise. Generate with:  openssl rand -hex 64
JWT_SECRET=<64-bytes-of-random-hex>

# ─── Deployment ──────────────────────────────────────────────────────────────

# Set to `production` when deploying. This turns on HSTS, switches logs to JSON,
# and is read by several libraries. Leaving it unset is a development-only
# posture.
NODE_ENV=development

PORT=3000

# Comma-separated list of origins allowed to call this API.
# REQUIRED in production — startup fails without it. In development it may be
# omitted, in which case any http://localhost:<port> origin is accepted so the
# Vite dev server works on whichever port it lands on.
# CORS_ORIGINS=https://app.myhomebase.dev

# Number of reverse proxies in front of this app, or a comma-separated list of
# trusted proxy addresses. Leave unset when the app is exposed directly.
#
# Get this right in both directions: unset behind a proxy makes every rate
# limiter key on the proxy's IP (so ten failed logins from anyone lock out
# every user), while `true` lets any client spoof X-Forwarded-For and bypass
# the limiters entirely. Prefer the hop count.
# TRUST_PROXY=1

# ─── Optional: tokens and 2FA ────────────────────────────────────────────────

# Signs the short-lived pre-authentication token issued during a 2FA challenge.
# Leave unset and it is derived from JWT_SECRET via HMAC, which is sufficient —
# set it only if you want an entirely independent key. It must never equal
# JWT_SECRET; startup fails if it does.
# JWT_PREAUTH_SECRET=<different-random-hex>

# Session token lifetime. Sessions are revocable (User.tokenVersion), so this is
# an exposure/UX trade-off rather than the only bound on a stolen token.
# SESSION_TOKEN_TTL=2d

# How long the pre-auth token stays valid while the user reads their email.
# PREAUTH_TOKEN_TTL=10m

# How long a device that has passed a 2FA challenge may skip the next one.
# Trust is bound to the device, not the account.
# DEVICE_TRUST_DAYS=7

# ─── Optional: limits ────────────────────────────────────────────────────────

# Maximum size of a single upload, in bytes (default 100 MB).
# MAX_UPLOAD_BYTES=104857600

# Total bytes any one user may store (default 5 GB). Checked before an upload is
# accepted and again against the written size.
# USER_STORAGE_QUOTA_BYTES=5368709120

# ─── Optional: password policy ───────────────────────────────────────────────

# PASSWORD_MIN_LENGTH=12

# Check candidate passwords against Have I Been Pwned using k-anonymity — only a
# 5-character SHA-1 prefix leaves this server, never the password. Fails open on
# a network error. Set to `false` for fully offline operation.
# PASSWORD_BREACH_CHECK=true

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Delivers 2FA codes and account-approval notices.

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=<smtp-api-key>
SMTP_FROM=Homebase.Verification@example.com

# ─── Testing ─────────────────────────────────────────────────────────────────

# `npm test` runs against this, NOT MONGO_URI. The database name must end in
# `_test` or the suite refuses to start; it is dropped before and after the run.
# MONGO_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/homebase_test
