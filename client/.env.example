# ============================================================
#  client/.env.example — frontend configuration.
#  Copy to client/.env to override. Vite only exposes variables
#  prefixed VITE_, and inlines them into the build at build time,
#  so nothing secret belongs in this file.
# ============================================================

# Origin of the Homebase API. Defaults to http://localhost:3000 when unset.
#
# Two server-side settings constrain what you can put here — both live in
# server/server.js, and getting either wrong fails at runtime, not at build:
#
#   1. CORS. The server's `origin` is an explicit allow-list read from
#      CORS_ORIGINS in the ROOT .env, and config/env.js refuses to boot in
#      production without it. Whatever origin serves this frontend must be
#      listed there, or every request is blocked.
#
#   2. Cross-Origin-Resource-Policy is set to `same-site`. File previews and
#      downloads are uploaded bytes served by that header, so an API on a
#      different SITE (not merely a different port or subdomain) will have
#      those responses blocked by the browser even with CORS configured.
#      api.example.com + app.example.com is fine; example.com + example.net
#      is not.
VITE_API_URL=http://localhost:3000
